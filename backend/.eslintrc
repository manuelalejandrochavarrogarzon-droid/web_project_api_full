{
  "env": {
    "es2021": true,
    "node": true,
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest",
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "next",
      },
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_id"],
      },
    ],
  },
}
